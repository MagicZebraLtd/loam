{
  "name": "@loam/desktop",
  "private": true,
  "version": "0.6.4",
  "productName": "LOAM",
  "description": "LOAM for Mac, Windows and Linux: run a local, off-grid LOAM network from a desktop app (embedded server + the web client in a window).",
  "license": "AGPL-3.0-only",
  "author": "Magic Zebra Ltd",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:native": "node scripts/native.mjs",
    "dev": "node scripts/build.mjs && electron .",
    "start": "electron .",
    "dist": "node scripts/build.mjs && node scripts/native.mjs && electron-builder --publish never",
    "smoke": "electron . --smoke",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@loam/crypto": "workspace:*",
    "@loam/qr": "workspace:*",
    "@loam/schema": "workspace:*",
    "@loam/tui": "workspace:*",
    "@preact/preset-vite": "catalog:",
    "@types/node": "catalog:",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "client": "workspace:*",
    "electron": "44.9.1",
    "electron-builder": "^26.15.3",
    "esbuild": "catalog:",
    "jsdom": "catalog:",
    "preact": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod": "^4.6.7"
  }
}
