<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for LOAM's macOS build (electron-builder.yml `mac.entitlements`, also used for the
  helper processes). Only what Electron's V8 needs: JIT and unsigned executable memory.

  Deliberately NOT granted: `disable-library-validation` and `allow-dyld-environment-variables`. With either, a
  local program could load its own dylib into LOAM (DYLD_INSERT_LIBRARIES, or a planted library) and ask the
  keychain for "LOAM Safe Storage" as LOAM, which is exactly what the fuses in electron-builder.yml shut out.
  Library validation still passes for the SQLCipher driver because electron-builder signs the unpacked .node with
  the app's own identity. The first build signed with a real Developer ID must re-test launch and the encrypted
  smoke run (LOAM_SMOKE_REQUIRE_ENCRYPTION=1) before release.

  No network-server entitlement is needed: the app isn't sandboxed (App Sandbox would stop it serving the LAN),
  and the macOS firewall asks the host about incoming connections on first listen.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
  </dict>
</plist>
